---
interface Props {
  date: Date;
}
const { date } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC', // dates are authored as plain YYYY-MM-DD (UTC midnight)
});
---

<time datetime={date.toISOString()}>{formatted}</time>
