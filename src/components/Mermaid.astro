---
// Usage in MDX:  <Mermaid chart={`flowchart LR; A-->B`} />
// Rendering is initialized once per page in the blog post layout.
interface Props {
  chart: string;
  /** Optional caption shown under the diagram. */
  caption?: string;
}
const { chart, caption } = Astro.props;
---

<figure class="mermaid-figure">
  <pre class="mermaid">{chart}</pre>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .mermaid-figure {
    margin: 1.75rem 0;
    text-align: center;
  }
  .mermaid-figure :global(.mermaid) {
    display: flex;
    justify-content: center;
  }
  .mermaid-figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-mm-muted);
  }
</style>
