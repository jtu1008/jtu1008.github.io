---
import { site, author, social } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description = site.description,
  noindex = false,
  ogImage = '/og-image.png',
} = Astro.props;

const fullTitle = title
  ? `${title} ${site.titleSeparator} ${site.title}`
  : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImageUrl = new URL(ogImage, site.url).href;

// JSON-LD Person schema — helps search engines understand who this is and
// connects the site to the owner's other profiles via `sameAs`.
const sameAs = social.filter((s) => s.url.startsWith('http')).map((s) => s.url);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  alternateName: author.nameZh,
  url: site.url,
  image: new URL(author.avatar, site.url).href,
  jobTitle: 'Applied Scientist',
  worksFor: {
    '@type': 'Organization',
    name: 'CodaMetrix',
    url: 'https://www.codametrix.com/',
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Brandeis University' },
  knowsAbout: [
    'Artificial Intelligence',
    'Natural Language Processing',
    'Large Language Models',
    'Computational Linguistics',
    'Medical Coding',
  ],
  sameAs,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/assets/images/logo.png" />

<!-- Set theme before paint to avoid a flash of the wrong color scheme. -->
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      var dark =
        stored === 'dark' ||
        (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
    } catch (e) {}
  })();
</script>

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${author.name} — ${author.bio}`} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
