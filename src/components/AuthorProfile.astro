---
import { author, social, type SocialIcon } from '../data/site';

const ICONS: Record<SocialIcon | 'location', string> = {
  location:
    'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z',
  email:
    'M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
  scholar: 'M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  twitter:
    'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
};
---

<aside class="author">
  <img class="author__avatar" src={author.avatar} alt={author.name} />
  <h3 class="author__name">{author.name}</h3>
  <p class="author__bio">{author.bio}</p>

  <p class="author__location">
    <svg viewBox="0 0 24 24" aria-hidden="true" class="author__pin"
      ><path fill="currentColor" d={ICONS.location}></path></svg
    >
    {author.location}
  </p>

  <ul class="author__social">
    {
      social.map((s) => (
        <li>
          <a
            href={s.url}
            aria-label={s.label}
            title={s.label}
            target={s.url.startsWith('http') ? '_blank' : undefined}
            rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d={ICONS[s.icon]} />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .author {
    text-align: center;
  }
  .author__avatar {
    width: 116px;
    height: 116px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.1rem;
    display: block;
    box-shadow:
      0 0 0 1px var(--color-mm-border),
      0 6px 18px rgba(24, 24, 27, 0.1);
  }
  .author__name {
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.3rem;
  }
  .author__bio {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-mm-muted);
    margin: 0 0 1.1rem;
  }
  .author__location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-mm-muted);
    margin: 0 0 1.2rem;
  }
  .author__pin {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }
  .author__social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .author__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9px;
    color: var(--color-mm-muted);
    border: 1px solid var(--color-mm-border-strong);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease,
      transform 0.18s ease;
  }
  .author__social a:hover {
    color: #fff;
    background: var(--color-mm-link);
    border-color: var(--color-mm-link);
    transform: translateY(-2px);
  }
  .author__social svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (min-width: 64rem) {
    .author {
      text-align: left;
      position: sticky;
      top: 6rem;
    }
    .author__avatar {
      margin: 0 0 1.1rem;
    }
    .author__location {
      justify-content: flex-start;
    }
    .author__social {
      justify-content: flex-start;
    }
  }
</style>
