---
import { site, nav } from '../data/site';

const current = Astro.url.pathname;
const isActive = (url: string) =>
  url === '/' ? current === '/' : current.startsWith(url);
---

<header class="masthead">
  <div class="masthead__inner">
    <a class="masthead__title" href="/">{site.title}</a>
    <div class="masthead__right">
      <nav class="masthead__nav" aria-label="Site navigation">
        {
          nav.map((item) => (
            <a
              href={item.url}
              class:list={['masthead__link', { 'is-active': isActive(item.url) }]}
            >
              {item.title}
            </a>
          ))
        }
      </nav>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg
          class="theme-toggle__sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          class="theme-toggle__moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-mm-border);
    background: color-mix(in srgb, var(--color-mm-masthead) 80%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
  }
  .masthead__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .masthead__title {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .masthead__title:hover {
    color: var(--color-ink);
  }
  .masthead__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .masthead__nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .masthead__link {
    position: relative;
    color: var(--color-mm-muted);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.4rem 0;
  }
  .masthead__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.1rem;
    width: 100%;
    height: 1.5px;
    background: var(--color-mm-link);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .masthead__link:hover {
    color: var(--color-ink);
  }
  .masthead__link.is-active {
    color: var(--color-ink);
  }
  .masthead__link.is-active::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9px;
    border: 1px solid var(--color-mm-border-strong);
    color: var(--color-mm-muted);
    background: transparent;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .theme-toggle:hover {
    color: var(--color-ink);
    border-color: var(--color-mm-muted);
  }
  .theme-toggle svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  /* Show moon in light mode, sun in dark mode. */
  .theme-toggle__sun {
    display: none;
  }
  .theme-toggle__moon {
    display: block;
  }
  :global(html.dark) .theme-toggle__sun {
    display: block;
  }
  :global(html.dark) .theme-toggle__moon {
    display: none;
  }
</style>
