---
import { site, nav } from '../data/site';

const current = Astro.url.pathname;
const isActive = (url: string) =>
  url === '/' ? current === '/' : current.startsWith(url);
---

<header class="masthead">
  <div class="masthead__inner">
    <a class="masthead__title" href="/">{site.title}</a>
    <nav class="masthead__nav" aria-label="Site navigation">
      {
        nav.map((item) => (
          <a
            href={item.url}
            class:list={['masthead__link', { 'is-active': isActive(item.url) }]}
          >
            {item.title}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--color-mm-border);
    background: var(--color-mm-masthead);
  }
  .masthead__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .masthead__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #3a3e42;
  }
  .masthead__title:hover {
    text-decoration: none;
  }
  .masthead__nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .masthead__link {
    color: var(--color-mm-text);
    font-weight: 600;
    padding: 0.25rem 0;
  }
  .masthead__link:hover {
    color: var(--color-mm-link);
    text-decoration: none;
  }
  .masthead__link.is-active {
    color: var(--color-mm-link);
  }
</style>
