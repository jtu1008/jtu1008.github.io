---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Masthead from '../components/Masthead.astro';
import AuthorProfile from '../components/AuthorProfile.astro';
import Footer from '../components/Footer.astro';

interface FrontmatterProps {
  title?: string;
  description?: string;
  /** Hide the left author sidebar (full-width content). */
  full?: boolean;
  /** Add noindex/nofollow (e.g. the private love-jin page). */
  noindex?: boolean;
  /** Centered reading column with wide media break-out (used by the blog). */
  wide?: boolean;
}

// Markdown pages pass values under `frontmatter`; .astro pages may pass directly.
const fm: FrontmatterProps = Astro.props.frontmatter ?? Astro.props;
const { title, description, full = false, noindex = false, wide = false } = fm;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <Masthead />

    <main class="layout">
      <div class:list={['layout__inner', { 'layout__inner--full': full }]}>
        {
          !full && (
            <div class="layout__sidebar">
              <AuthorProfile />
            </div>
          )
        }
        <article class:list={['layout__content', { 'layout__content--wide': wide }]}>
          {title && <h1 class="page-title">{title}</h1>}
          <div class:list={['page-content', { 'page-content--wide': wide }]}>
            <slot />
          </div>
        </article>
      </div>
    </main>

    <Footer />

    <style>
      .layout__inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .layout__content {
        min-width: 0;
      }
      .page-title {
        font-size: 2rem;
        font-weight: 650;
        letter-spacing: -0.025em;
        color: var(--color-ink);
        margin: 0 0 1.5rem;
      }
      @media (min-width: 64rem) {
        .layout__inner {
          grid-template-columns: 220px minmax(0, 1fr);
          gap: 4rem;
          padding: 3.5rem 1.5rem;
        }
        .layout__inner--full {
          grid-template-columns: minmax(0, 1fr);
        }
        /* Blog: center the title to match the grid's reading column (see global.css). */
        .layout__content--wide .page-title {
          max-width: 680px;
          margin-inline: auto;
        }
      }
    </style>
  </body>
</html>
