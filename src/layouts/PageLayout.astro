---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Masthead from '../components/Masthead.astro';
import AuthorProfile from '../components/AuthorProfile.astro';
import Footer from '../components/Footer.astro';

interface FrontmatterProps {
  title?: string;
  description?: string;
  /** Hide the left author sidebar (full-width content). */
  full?: boolean;
  /** Add noindex/nofollow (e.g. the private love-jin page). */
  noindex?: boolean;
}

// Markdown pages pass values under `frontmatter`; .astro pages may pass directly.
const fm: FrontmatterProps = Astro.props.frontmatter ?? Astro.props;
const { title, description, full = false, noindex = false } = fm;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <Masthead />

    <main class="layout">
      <div class:list={['layout__inner', { 'layout__inner--full': full }]}>
        {
          !full && (
            <div class="layout__sidebar">
              <AuthorProfile />
            </div>
          )
        }
        <article class="layout__content">
          {title && <h1 class="page-title">{title}</h1>}
          <div class="page-content">
            <slot />
          </div>
        </article>
      </div>
    </main>

    <Footer />

    <style>
      .layout__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .layout__content {
        min-width: 0;
      }
      .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #3a3e42;
        margin: 0 0 1.25rem;
      }
      @media (min-width: 64rem) {
        .layout__inner {
          grid-template-columns: 230px minmax(0, 1fr);
          gap: 3rem;
        }
        .layout__inner--full {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    </style>
  </body>
</html>
